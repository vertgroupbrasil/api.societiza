{
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet run*)",
      "Bash(dotnet ef migrations add*)",
      "Bash(dotnet ef database update*)",
      "Bash(docker-compose -f Docker/docker-compose.Infrastructure.Development.yaml*)",
      "Bash(docker build --no-cache -t societiza-api .)",
      "Bash(docker ps*)",
      "Bash(docker logs*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(dotnet ef database drop*)",
      "Bash(dotnet ef migrations remove*)",
      "Bash(docker-compose down -v*)"
    ]
  }
}