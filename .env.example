# --- Enviroment ---
ASPNETCORE_ENVIRONMENT=Development

# --- Connection Strings (PostgreSQL) ---
ConnectionStrings__Default=Server=societiza-postgres-dev;Port=5432;Username=societiza;Password=societiza;Database=societiza;
ConnectionStrings__Hangfire=Server=societiza-postgres-dev;Port=5432;Username=societiza;Password=societiza;Database=societiza;

# --- Projections (MongoDB) ---
Projections__Accountancy=mongodb://societiza:societiza@societiza-mongodb-dev:27017/societiza?authSource=admin
Projections__WorkflowTemplate=mongodb://societiza:societiza@societiza-mongodb-dev:27017/societiza?authSource=admin

# --- Event Bus (RabbitMQ) ---
EventBusOptions__ConnectionString=amqp://guest:guest@societiza-rabbitmq-dev:5672/

# --- Email (Brevo) ---
EmailOptions__Username=your_login_brevo
EmailOptions__Password=your_smtp_key_brevo
EmailOptions__FromEmail=yourgmail@gmail.com